<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EFFF"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"
                android:text="←  뒤로가기"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

            <!-- 메인 제목 수정 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="회원가입 - 약관동의"
                android:textColor="@android:color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="앱 사용을 위한 필수 동의 사항입니다."
                android:textColor="#9E9E9E"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="필수 동의 사항"
                android:textColor="#9E9E9E"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- 서비스 이용약관 -->
                <TextView
                    android:id="@+id/tvTermTitle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="서비스 이용약관 (필수)"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbTerm1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#E0E0E0"
                    android:enabled="false"
                    android:paddingStart="8dp"
                    android:text="동의하십니까? (약관을 먼저 읽어주세요)"
                    android:textColor="#BDBDBD"
                    android:textSize="13sp" />

                <!-- 알림 분석 동의 -->
                <TextView
                    android:id="@+id/tvTermTitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="알림 분석 동의 (필수)"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbTerm2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#E0E0E0"
                    android:enabled="false"
                    android:paddingStart="8dp"
                    android:text="동의하십니까? (약관을 먼저 읽어주세요)"
                    android:textColor="#BDBDBD"
                    android:textSize="13sp" />

                <!-- 문자 분석 동의 -->
                <TextView
                    android:id="@+id/tvTermTitle3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="문자 분석 동의 (필수)"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbTerm3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#E0E0E0"
                    android:enabled="false"
                    android:paddingStart="8dp"
                    android:text="동의하십니까? (약관을 먼저 읽어주세요)"
                    android:textColor="#BDBDBD"
                    android:textSize="13sp" />

                <!-- 알람 설정 동의 -->
                <TextView
                    android:id="@+id/tvTermTitle4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="알람 설정 동의 (필수)"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbTerm4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#E0E0E0"
                    android:enabled="false"
                    android:paddingStart="8dp"
                    android:text="동의하십니까? (약관을 먼저 읽어주세요)"
                    android:textColor="#BDBDBD"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#FFF5F5"
                android:gravity="center"
                android:padding="12dp"
                android:text="모든 필수 동의 사항에 동의해주세요!"
                android:textColor="#FF5252"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@android:color/black"
                android:text="다음"
                android:textColor="@android:color/white"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
