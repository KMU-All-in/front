<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CFDCFF"
    android:paddingHorizontal="28dp"
    android:paddingTop="52dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp">

            <TextView
                android:id="@+id/tvLockAdvice"
                android:layout_width="300dp"
                android:layout_height="76dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_lock_speech"
                android:gravity="center"
                android:textAlignment="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="6dp"
                android:paddingBottom="20dp"
                android:text="잠깐! 저는 쇼핑 앱 감지 경찰입니다.\n정말 필요한 물건인가요?"
                android:textColor="#596273"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageView
            android:id="@+id/ivLockCharacter"
            android:layout_width="150dp"
            android:layout_height="170dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_lock_image_area"
            android:padding="34dp"
            android:alpha="0.55"
            android:src="@android:drawable/ic_menu_help"
            app:tint="#8FAAF5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 잠금 해제"
            android:textColor="#4F5F8A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp" />

        <LinearLayout
            android:id="@+id/pinIndicatorContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <View android:layout_width="18dp" android:layout_height="18dp" android:layout_marginHorizontal="9dp" android:background="@drawable/pin_dot_off" />
            <View android:layout_width="18dp" android:layout_height="18dp" android:layout_marginHorizontal="9dp" android:background="@drawable/pin_dot_off" />
            <View android:layout_width="18dp" android:layout_height="18dp" android:layout_marginHorizontal="9dp" android:background="@drawable/pin_dot_off" />
            <View android:layout_width="18dp" android:layout_height="18dp" android:layout_marginHorizontal="9dp" android:background="@drawable/pin_dot_off" />
        </LinearLayout>
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:columnCount="3"
        android:rowCount="4">

        <Button style="@style/KeypadButton" android:text="1" />
        <Button style="@style/KeypadButton" android:text="2" />
        <Button style="@style/KeypadButton" android:text="3" />

        <Button style="@style/KeypadButton" android:text="4" />
        <Button style="@style/KeypadButton" android:text="5" />
        <Button style="@style/KeypadButton" android:text="6" />

        <Button style="@style/KeypadButton" android:text="7" />
        <Button style="@style/KeypadButton" android:text="8" />
        <Button style="@style/KeypadButton" android:text="9" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1" />

        <Button style="@style/KeypadButton" android:text="0" />

        <ImageButton
            android:id="@+id/btnBackspace"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_lock_key"
            android:padding="18dp"
            android:src="@android:drawable/ic_input_delete"
            app:tint="#8FAAF5" />
    </GridLayout>

</LinearLayout>