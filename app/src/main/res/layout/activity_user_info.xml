<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내 정보 설정"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@android:color/white">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="닉네임"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etNickname"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="#F2F4F8"
                    android:hint="닉네임을 입력해주세요"
                    android:paddingStart="12dp"
                    android:textColor="#424242"
                    android:textColorHint="#9E9E9E"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="이메일"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etUserEmail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="#F2F4F8"
                    android:hint="login@example.com"
                    android:inputType="textEmailAddress"
                    android:paddingStart="12dp"
                    android:textColor="#424242"
                    android:textColorHint="#9E9E9E"
                    android:textSize="14sp" />

                <!-- [추가] 계정 비밀번호 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="비밀번호"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etUserPw"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="#F2F4F8"
                    android:hint="6자리 이상 입력해주세요"
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:textColor="#424242"
                    android:textColorHint="#9E9E9E"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="비밀번호 확인"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etUserPwConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="#F2F4F8"
                    android:hint="비밀번호를 한 번 더 입력해주세요"
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:textColor="#424242"
                    android:textColorHint="#9E9E9E"
                    android:textSize="14sp" />

                <!-- 연령대, 직업, 관심사 (기존 유지) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="연령대"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/spAge"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="#F2F4F8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="직업"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etUserJob"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="#F2F4F8"
                    android:hint="예: 학생, 직장인 등"
                    android:paddingStart="12dp"
                    android:textColor="#424242"
                    android:textColorHint="#9E9E9E"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="주요 관심사"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:columnCount="2">
                    <CheckBox android:id="@+id/cbFashion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="패션/의류" />
                    <CheckBox android:id="@+id/cbBeauty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="뷰티/화장품" />
                    <CheckBox android:id="@+id/cbDigital" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="전자기기" />
                    <CheckBox android:id="@+id/cbFood" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="식품/음료" />
                </GridLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@android:color/black"
            android:text="다음 단계로"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
