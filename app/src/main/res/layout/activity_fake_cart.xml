<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EFFF">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="가짜 장바구니"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="충동구매 방지 앱"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />
        </LinearLayout>
        <Button
            android:id="@+id/btnAddProduct"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#4F6FFF"
            android:text="+ 상품 추가"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:cornerRadius="8dp" />
        <Button
            android:id="@+id/btnStartSelection"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#F2F4F8"
            android:text="선택하기"
            android:textColor="@android:color/black"
            android:textSize="12sp"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_below="@id/topBar"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/cbSelectAllProducts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#4F6FFF"
            android:text="상품 전체 선택"
            android:textColor="#424242"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnDeleteSelected"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#E53935"
            android:text="선택한 상품 삭제"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="4dp" />

        <Button
            android:id="@+id/btnCancelSelection"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#F2F4F8"
            android:text="취소"
            android:textColor="@android:color/black"
            android:textSize="12sp"
            app:cornerRadius="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/selectionBar"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/cartItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp" />
    </ScrollView>

    <View android:id="@+id/dimView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true" />

    <!-- 상품 추가 팝업 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAddProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="24dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        android:elevation="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:text="상품 추가" android:textColor="@android:color/black" android:textSize="18sp" android:textStyle="bold" />
                <ImageView android:id="@+id/btnCloseCard" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </RelativeLayout>

            <FrameLayout
                android:id="@+id/layoutPhotoPreview"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="16dp"
                android:background="#F2F4F8"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ivPhotoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#CCCCCC" />
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="16dp" android:orientation="horizontal">
                <Button android:id="@+id/tabUrl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="URL" android:textSize="11sp" android:backgroundTint="#000000" android:textColor="#FFFFFF" app:cornerRadius="6dp" style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
                <Button android:id="@+id/tabPhoto" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:text="사진" android:textSize="11sp" android:backgroundTint="#F2F4F8" android:textColor="#666666" app:cornerRadius="6dp" style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
                <Button android:id="@+id/tabManual" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="직접 입력" android:textSize="11sp" android:backgroundTint="#F2F4F8" android:textColor="#666666" app:cornerRadius="6dp" style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/layoutUrlInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical">
                <EditText android:id="@+id/etUrlInput" android:layout_width="match_parent" android:layout_height="45dp" android:background="#F2F4F8" android:hint="상품 URL을 입력하세요" android:paddingStart="12dp" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/layoutPhotoInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="카메라 아이콘을 눌러 사진을 등록하세요" android:textSize="11sp" android:textColor="#9E9E9E"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/layoutManualInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="16dp">
                <EditText android:id="@+id/etManualName" android:layout_width="match_parent" android:layout_height="45dp" android:hint="상품명" android:background="#F2F4F8" android:paddingStart="12dp" android:textSize="13sp" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/etManualPrice" android:layout_width="match_parent" android:layout_height="45dp" android:hint="가격(원)" android:inputType="number" android:background="#F2F4F8" android:paddingStart="12dp" android:textSize="13sp"/>
            </LinearLayout>
            
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="삭제까지 남은 기간" android:textSize="12sp" android:textStyle="bold"/>
            <Spinner android:id="@+id/spExpiry" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="4dp" android:background="#F2F4F8" />
            <Button android:id="@+id/btnSubmit" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp" android:backgroundTint="#4F6FFF" android:text="장바구니에 담기" app:cornerRadius="10dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 수정 팝업 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardEditProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="24dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        android:elevation="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:text="정보 수정" android:textStyle="bold" />
                <ImageView android:id="@+id/btnCloseEdit" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </RelativeLayout>
            
            <FrameLayout android:id="@+id/layoutEditPhoto" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="16dp" android:background="#F2F4F8">
                <ImageView android:id="@+id/ivEditPhotoPreview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" />
            </FrameLayout>

            <EditText android:id="@+id/etEditName" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="16dp" android:background="#F2F4F8" android:paddingStart="12dp" />
            <EditText android:id="@+id/etEditPrice" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="8dp" android:background="#F2F4F8" android:paddingStart="12dp" android:inputType="number" />
            <EditText android:id="@+id/etEditUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />

            <Button android:id="@+id/btnSubmitEdit" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp" android:backgroundTint="#4F6FFF" android:text="수정 완료" app:cornerRadius="10dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 이유 추가 팝업 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAddReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="24dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        android:elevation="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:text="왜 사고 싶나요?" android:textStyle="bold" />
                <ImageView android:id="@+id/btnCloseReason" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </RelativeLayout>
            <EditText android:id="@+id/etNewReason" android:layout_width="match_parent" android:layout_height="100dp" android:layout_marginTop="16dp" android:background="#F2F4F8" android:padding="12dp" android:gravity="top" />
            <Button android:id="@+id/btnSubmitReason" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp" android:backgroundTint="#4F6FFF" android:text="이유 등록" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- OCR 결과 선택 팝업 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardOcrResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="24dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        android:elevation="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:text="분석된 텍스트 선택" android:textStyle="bold" android:textSize="16sp" />
                <ImageView android:id="@+id/btnCloseOcr" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </RelativeLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="상품명과 가격에 해당하는 줄을 클릭하여 선택하세요." android:textSize="12sp" android:textColor="#666666"/>
            
            <ScrollView android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="16dp">
                <LinearLayout android:id="@+id/ocrLinesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </ScrollView>

            <Button android:id="@+id/btnApplyOcr" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp" android:backgroundTint="#4F6FFF" android:text="선택 완료" app:cornerRadius="10dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
